{
  "manifest_version": 3,
  "name": "LeadMind LinkedIn Copilot",
  "version": "1.0.0",
  "description": "Analyze LinkedIn profiles and generate outreach using AI",
  "permissions": ["activeTab"],
  "host_permissions": ["http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}
